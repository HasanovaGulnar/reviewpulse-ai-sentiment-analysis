# Copy this file to .streamlit/secrets.toml for local runs, or paste the same
# keys into Streamlit Community Cloud -> app -> Settings -> Secrets.
#
# Both values are optional. Without them feedback is written to logs/feedback.csv
# on the app instance, which is lost when a hosted app restarts.

# Any endpoint that accepts a JSON POST (Google Apps Script, Formspree, ...).
# The app sends {"type": "feedback", "category": ..., "message": ..., ...}
# and {"type": "session_start", ...} / {"type": "analysis", ...} events.
# REVIEWPULSE_WEBHOOK_URL = "https://script.google.com/macros/s/XXX/exec"

# A plain Google Form, shown as an alternative to the in-app form.
# REVIEWPULSE_FEEDBACK_FORM_URL = "https://forms.gle/XXX"
